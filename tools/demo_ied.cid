<?xml version="1.0" encoding="UTF-8"?>
<!-- DEMO CID for tests of the GOOSE publisher (synthetic, not a real project) -->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B">
  <Header id="demo_ied"/>
  <Communication>
    <SubNetwork name="PB_A" type="8-MMS">
      <ConnectedAP iedName="DEMO_IED" apName="AP1">
        <Address><P type="IP">192.168.1.20</P><P type="IP-SUBNET">255.255.255.0</P></Address>
        <GSE ldInst="LD0" cbName="GCB1">
          <Address>
            <P type="MAC-Address">01-0C-CD-01-0F-01</P><P type="APPID">0F01</P>
            <P type="VLAN-ID">065</P><P type="VLAN-PRIORITY">4</P>
          </Address>
          <MinTime unit="s" multiplier="m">4</MinTime>
          <MaxTime unit="s" multiplier="m">1000</MaxTime>
        </GSE>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="DEMO_IED" manufacturer="DEMO" type="BCU">
    <AccessPoint name="AP1"><Server><Authentication/>
      <LDevice inst="LD0">
        <LN0 lnClass="LLN0" inst="" lnType="LLN0_T">
          <DataSet name="DS1">
            <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="Ind1" daName="stVal" fc="ST"/>
            <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="Ind1" daName="q" fc="ST"/>
            <FCDA ldInst="LD0" prefix="Q0" lnClass="XCBR" lnInst="1" doName="Pos" daName="stVal" fc="ST"/>
            <FCDA ldInst="LD0" lnClass="MMXU" lnInst="1" doName="TotW" daName="mag.f" fc="MX"/>
            <FCDA ldInst="LD0" lnClass="LLN0" doName="Mod" daName="stVal" fc="ST"/>
            <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="Ind2" fc="ST"/>
          </DataSet>
          <GSEControl name="GCB1" datSet="DS1" appID="DEMO_IED_GOOSE1" confRev="3" type="GOOSE"/>
          <ReportControl name="urcbA" datSet="DS1" rptID="DEMO_IED_urcbA" confRev="1" buffered="false" intgPd="5000">
            <TrgOps dchg="true" qchg="true" period="true" gi="true"/>
            <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" configRef="true"/>
            <RptEnabled max="1"/>
          </ReportControl>
        </LN0>
        <LN lnClass="GGIO" inst="1" lnType="GGIO_T"/>
        <LN prefix="Q0" lnClass="XCBR" inst="1" lnType="XCBR_T"/>
        <LN lnClass="MMXU" inst="1" lnType="MMXU_T"/>
      </LDevice>
    </Server></AccessPoint>
  </IED>
  <DataTypeTemplates>
    <LNodeType id="LLN0_T" lnClass="LLN0"><DO name="Mod" type="ENC_Mod"/></LNodeType>
    <LNodeType id="GGIO_T" lnClass="GGIO"><DO name="Ind1" type="SPS_T"/><DO name="Ind2" type="SPS_T"/></LNodeType>
    <LNodeType id="XCBR_T" lnClass="XCBR"><DO name="Pos" type="DPC_T"/></LNodeType>
    <LNodeType id="MMXU_T" lnClass="MMXU"><DO name="TotW" type="MV_T"/></LNodeType>
    <DOType id="SPS_T" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST"/><DA name="q" bType="Quality" fc="ST"/><DA name="t" bType="Timestamp" fc="ST"/>
    </DOType>
    <DOType id="DPC_T" cdc="DPC">
      <DA name="stVal" bType="Dbpos" fc="ST"/><DA name="q" bType="Quality" fc="ST"/><DA name="t" bType="Timestamp" fc="ST"/>
    </DOType>
    <DOType id="MV_T" cdc="MV">
      <DA name="mag" bType="Struct" type="AV_T" fc="MX"/><DA name="q" bType="Quality" fc="MX"/>
    </DOType>
    <DOType id="ENC_Mod" cdc="ENC">
      <DA name="stVal" bType="Enum" type="Beh" fc="ST"/><DA name="q" bType="Quality" fc="ST"/>
    </DOType>
    <DAType id="AV_T"><BDA name="f" bType="FLOAT32"/></DAType>
    <EnumType id="Beh">
      <EnumVal ord="1">on</EnumVal><EnumVal ord="2">blocked</EnumVal><EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal><EnumVal ord="5">off</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>
